{
  "title": "Events",
  "description": "A widget that allows to easily integrate the list or map view of the events that are taking place in all South Tyrol or near a certain location. The map loads clustered vector tiles from the Open Data Hub Geo Api; details are loaded on click from the Tourism Api.",
  "descriptionAbstract": "This web component shows all events provided by the Open Data Hub.",
  "license": "AGPL-3.0-or-later",
  "repositoryUrl": "https://github.com/noi-techpark/webcomp-events.git",
  "shortName": "events",
  "copyrightHolders": [
    {
      "name": "NOI",
      "email": "info@noi.bz.it",
      "organization": "NOI S.p.A",
      "organizationUrl": "https://noi.bz.it"
    }
  ],
  "authors": [
    {
      "name": "Belka",
      "email": "hello@belkadigital.com",
      "organization": "Belka",
      "organizationUrl": "https://belkadigital.com/"
    }
  ],
  "image": "wcs-logo.png",
  "searchTags": [
    "events",
    "map",
    "tourism"
  ],
  "dist": {
    "basePath": "dist",
    "files": [
      "odh-events.js",
      "odh-events.js.LICENSE.txt"
    ],
    "scripts": [
      {
        "file": "odh-events.js",
        "parameter": ""
      }
    ]
  },
  "configuration": {
    "tagName": "odh-events",
    "options": [
      {
        "key": "width",
        "type": "text",
        "label": "Width of the component as css property (es: '500px' or '100%')",
        "required": false,
        "options": {
          "default": "100%"
        }
      },
      {
        "key": "height",
        "type": "text",
        "label": "Height of the component as css property (es: '500px' or '100%')",
        "required": false,
        "options": {
          "default": "100%"
        }
      },
      {
        "key": "language",
        "type": "select",
        "label": "Two letter key for the language to be used, if omitted the widget will use the language of the browser (navigator.language[?s]) if supported. Fallback is `en`",
        "required": false,
        "options": {
          "values": [
            "en",
            "de",
            "it"
          ],
          "default": "en"
        }
      },
      {
        "key": "modality",
        "type": "select",
        "label": "Visualization of the data",
        "required": true,
        "options": {
          "values": [
            "map",
            "list"
          ],
          "default": "map"
        }
      },
      {
        "key": "fontFamily",
        "type": "text",
        "label": "Main font family",
        "required": false,
        "options": {
          "default": "Arial"
        }
      },
      {
        "key": "currentLocation",
        "type": "text",
        "label": "Coordinates of the current location in the following format: { \"lat\": 46.31, \"lng\": 11.26 }",
        "required": true,
        "options": {
          "default": "{ \"lat\": 46.31, \"lng\": 11.26 }"
        }
      },
      {
        "key": "mapAttribution",
        "type": "text",
        "label": "Extra attribution text for the basemap (HTML without double-quotes)",
        "required": false,
        "options": {
          "default": "<a target='_blank' href='https://opendatahub.com'>OpenDataHub.com</a>"
        }
      },
      {
        "key": "tiles-url",
        "type": "text",
        "label": "MapLibre style URL for the basemap",
        "required": false,
        "options": {
          "default": "https://tiles.openfreemap.org/styles/positron"
        }
      },
      {
        "key": "source",
        "type": "multiselect",
        "label": "Sources of the Events (comma-separated when set as attribute)",
        "required": false,
        "options": {
          "values": [
            "drin",
            "ebms",
            "lts",
            "momentus",
            "nobis",
            "noi",
            "peer",
            "retealfemminile",
            "trevilab",
            "unibz"
          ]
        }
      },
      {
        "key": "begindate",
        "type": "text",
        "label": "Only show events on or after this date (yyyy-MM-dd). Default is today so past events are hidden.",
        "required": false,
        "options": {
          "default": "now"
        }
      },
      {
        "key": "enddate",
        "type": "text",
        "label": "Only show events on or before this date (yyyy-MM-dd). Leave empty for no upper bound.",
        "required": false,
        "options": {
          "default": null
        }
      },
      {
        "key": "filterRadius",
        "type": "text",
        "label": "Radius in km around currentLocation (drawn on the map; also filters list modality via Tourism Api). Default 0.",
        "required": true,
        "options": {
          "default": "0"
        }
      },
      {
        "key": "disableEventDirections",
        "type": "null",
        "label": "If set the road directions are hidden.",
        "required": false,
        "options": {
          "default": false
        }
      },
      {
        "key": "categoriesFilter",
        "type": "text",
        "label": "If set, events are filtered by the topic bitmask values in the array (list modality / Tourism Api).",
        "required": false,
        "options": {
          "default": "[]"
        }
      }
    ]
  }
}
